---
import ContactForm from "../components/blocks/ContactForm.astro";
import Faq from "../components/blocks/Faq.astro";
import Hero from "../components/blocks/Hero.astro";
import IntroCard from "../components/blocks/IntroCard.astro";
import Process from "../components/blocks/Process.astro";
import ProjectsGrid from "../components/blocks/ProjectsGrid.astro";
import Services from "../components/blocks/Services.astro";
import StatsTicker from "../components/blocks/StatsTicker.astro";
import Testimonials from "../components/blocks/Testimonials.astro";
import Section from "../components/primitives/Section.astro";
import Base from "../layouts/Base.astro";
import {
	getPage,
	getProjects,
	getSection,
	getSiteOptions,
	useCacheHint,
} from "../lib/queries";

const [options, featured, all, experience, stats, services, process, testimonials, faqs] =
	await Promise.all([
		getSiteOptions(),
		getProjects({ featuredOnly: true, limit: 4 }),
		getProjects({ limit: 8 }),
		getSection("experience"),
		getSection("stats"),
		getSection("services"),
		getSection("process_steps"),
		getSection("testimonials"),
		getSection("faqs"),
	]);

const { entry: about } = await getPage("about");

useCacheHint(
	Astro,
	options.cacheHint,
	featured.cacheHint,
	all.cacheHint,
	experience.cacheHint,
	stats.cacheHint,
	services.cacheHint,
	process.cacheHint,
	testimonials.cacheHint,
	faqs.cacheHint,
);

const o = options.options;
---

<Base description={o?.hero_tagline}>
	{/*
	  Section order taken from the source page tree:
	  Hero › About › Brands › Projects › KPI › Testimonials › Process ›
	  Services › FAQ › Contact. The carousel belongs to the Hero there,
	  so it is rendered inside it rather than as its own band.
	*/}
	<Hero options={o} projects={all.projects} />

	<Section heading="Mindset, methods, & experience">
		<IntroCard
			intro={about?.data.intro}
			content={about?.data.content}
			roles={experience.items}
		/>
	</Section>

	<Section heading="Designed, Built, & Shipped">
		<ProjectsGrid
			projects={featured.projects}
			caption="Selected projects that reflect my approach to design, development, and execution."
			showArchiveLink
		/>
	</Section>

	<Section flush>
		<StatsTicker stats={stats.items} />
	</Section>

	<Section eyebrow="Testimonials" heading="Good work gets noticed">
		<Testimonials testimonials={testimonials.items} />
	</Section>

	<Section heading="How things get built together">
		<Process steps={process.items} />
	</Section>

	<Section heading="End-to-end design services">
		<Services services={services.items} />
	</Section>

	<Section heading="Before you ask">
		<Faq faqs={faqs.items} />
	</Section>

	<Section flush>
		<ContactForm email={o?.contact_email} />
	</Section>
</Base>
