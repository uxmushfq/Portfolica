---
/**
 * SiteHeader — avatar, primary navigation, booking CTA, email link.
 * Every value is CMS-driven: the menu comes from the `primary` menu and the
 * rest from site options.
 */
import { Image } from "emdash/ui";

interface Props {
	menu?: { items: Array<{ label?: string; url?: string; target?: string }> } | null;
	settings?: Record<string, any> | null;
	options?: Record<string, any> | null;
	isLoggedIn?: boolean;
}

const { menu, settings, options, isLoggedIn = false } = Astro.props;

const siteTitle = settings?.title || "Portfolica";
const avatar = options?.avatar ?? settings?.logo ?? null;
const bookingUrl = options?.booking_url;
const email = options?.contact_email;
---

<header class="site-header">
	<div class="container-page header-inner">
		<a href="/" class="brand" aria-label={`${siteTitle} — home`}>
			{
				avatar ? (
					<Image image={avatar} alt={siteTitle} width={40} height={40} class="brand-avatar" />
				) : (
					<span class="brand-fallback" aria-hidden="true" />
				)
			}
		</a>

		<nav class="nav" aria-label="Primary">
			{
				menu?.items?.map((item) => (
					<a
						href={item.url}
						target={item.target}
						rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
						aria-current={Astro.url.pathname === item.url ? "page" : undefined}
					>
						{item.label}
					</a>
				))
			}
			{isLoggedIn && <a href="/_emdash/admin" class="nav-admin">Admin</a>}
		</nav>

		<div class="header-actions">
			{
				bookingUrl && (
					<a href={bookingUrl} class="btn btn-accent" target="_blank" rel="noopener noreferrer">
						Book a 30 min call
					</a>
				)
			}
			{
				email && (
					<a href={`mailto:${email}`} class="icon-btn" aria-label={`Email ${siteTitle}`}>
						<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
							<rect x="2.5" y="4.5" width="19" height="15" rx="3" />
							<path d="m3 7 8.2 5.6a1.5 1.5 0 0 0 1.6 0L21 7" />
						</svg>
					</a>
				)
			}
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		padding-block: var(--space-4);
		background: color-mix(in srgb, var(--color-bg) 85%, transparent);
		backdrop-filter: blur(12px);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
	}

	.brand {
		display: flex;
		flex: 0 0 auto;
	}

	.brand-avatar,
	.brand-fallback {
		width: 40px;
		height: 40px;
		border-radius: var(--radius-full);
		object-fit: cover;
	}

	.brand-fallback {
		background: var(--color-accent);
	}

	.nav {
		display: none;
		gap: var(--space-6);
		font-size: var(--text-base);
		font-weight: var(--weight-medium);
	}

	.nav a {
		color: var(--color-muted);
		transition: color var(--dur-fast) var(--ease-ui);
	}

	.nav a:hover,
	.nav a[aria-current="page"] {
		color: var(--color-text);
	}

	.nav-admin {
		opacity: 0.6;
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: var(--space-3) var(--space-5);
		border-radius: var(--radius-pill);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		letter-spacing: var(--tracking-button);
		/* The one transition measured on the original. */
		transition:
			background var(--dur-base) var(--ease-ui),
			box-shadow var(--dur-base) var(--ease-ui);
	}

	.btn-accent {
		background: var(--color-accent);
		color: var(--color-on-accent);
	}

	.btn-accent:hover {
		background: var(--color-accent-hover);
		box-shadow: 0 0 0 4px var(--color-accent-ring);
	}

	.icon-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border-radius: var(--radius-full);
		background: var(--color-surface);
		color: var(--color-text);
		transition:
			background var(--dur-base) var(--ease-ui),
			box-shadow var(--dur-base) var(--ease-ui);
	}

	.icon-btn:hover {
		box-shadow: 0 0 0 4px var(--color-accent-ring);
	}

	@media (min-width: 810px) {
		.nav {
			display: flex;
		}
	}
</style>
