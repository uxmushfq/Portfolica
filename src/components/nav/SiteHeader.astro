---
/**
 * SiteHeader — rebuilt 1:1 against the original, from measured geometry.
 *
 * Measured from portfolica.framer.website (computed styles, 3 breakpoints):
 *
 *   bar            sticky, 10px from the top, 56px tall
 *   left pill      white, radius 50px, padding 8px 60px 8px 8px, gap 48px
 *   avatar         40x40 circle
 *   nav links      16px / weight 500 / #27272a, 48px apart
 *   book button    white pill, 56 tall, radius 50px, padding-inline 30px
 *   mail button    white circle 56x56, 24px icon in the accent orange
 *   right group    flush right, no gap between the two buttons
 *   mobile         the avatar is replaced by a 56x56 menu button, radius 20px
 *
 * Note the buttons are white, not orange: the only orange in the header is
 * the avatar and the mail icon.
 */
import { Image } from "emdash/ui";

interface Props {
	menu?: { items: Array<{ label?: string; url?: string; target?: string }> } | null;
	settings?: Record<string, any> | null;
	options?: Record<string, any> | null;
	isLoggedIn?: boolean;
}

const { menu, settings, options, isLoggedIn = false } = Astro.props;

const siteTitle = settings?.title || "Portfolica";
const avatar = options?.avatar ?? settings?.logo ?? null;
const bookingUrl = options?.booking_url;
const bookingLabel = options?.booking_label || "Book a 30 min call";
const bookingLabelShort = options?.booking_label_short || "Book a call";
const email = options?.contact_email;
const items = menu?.items ?? [];
const path = Astro.url.pathname;
---

<header class="site-header">
	<div class="container-page header-inner">
		<!-- Left: avatar + links in one pill (tablet and up) -->
		<div class="navpill">
			<a href="/" class="brand" aria-label={`${siteTitle} — home`}>
				{
					avatar ? (
						<Image image={avatar} alt="" width={40} height={40} class="brand-avatar" />
					) : (
						<span class="brand-fallback" aria-hidden="true" />
					)
				}
			</a>

			<nav class="nav" aria-label="Primary">
				{
					items.map((item) => (
						<a
							href={item.url}
							target={item.target}
							rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
							aria-current={path === item.url ? "page" : undefined}
						>
							{item.label}
						</a>
					))
				}
				{isLoggedIn && <a href="/_emdash/admin" class="nav-admin">Admin</a>}
			</nav>
		</div>

		<!-- Left on mobile: the same links behind a disclosure -->
		<details class="menu">
			<summary class="menu-toggle" aria-label="Menu">
				<span class="bars" aria-hidden="true"></span>
			</summary>
			<nav class="menu-panel" aria-label="Primary">
				{
					items.map((item) => (
						<a
							href={item.url}
							target={item.target}
							rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
							aria-current={path === item.url ? "page" : undefined}
						>
							{item.label}
						</a>
					))
				}
				{isLoggedIn && <a href="/_emdash/admin">Admin</a>}
			</nav>
		</details>

		<!-- Right: booking pill + mail, flush to the edge -->
		<div class="actions">
			{
				bookingUrl && (
					<a href={bookingUrl} class="book" target="_blank" rel="noopener noreferrer">
						<span class="book-long">{bookingLabel}</span>
						<span class="book-short">{bookingLabelShort}</span>
					</a>
				)
			}
			{
				email && (
					<a href={`mailto:${email}`} class="mail" aria-label={`Email ${siteTitle}`}>
						<svg
							viewBox="0 0 24 24"
							width="24"
							height="24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.75"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<rect x="2.5" y="5" width="19" height="14" rx="3.5" />
							<path d="m3.5 8 7.6 5.1a1.6 1.6 0 0 0 1.8 0L20.5 8" />
						</svg>
					</a>
				)
			}
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		padding-block: 10px;
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
	}

	/* --- left pill: avatar + links ------------------------------------- */
	.navpill {
		display: none;
		align-items: center;
		gap: 48px;
		height: 56px;
		padding: 8px 60px 8px 8px;
		background: var(--color-surface);
		border-radius: 50px;
	}

	.brand {
		display: flex;
		flex: 0 0 auto;
	}

	.brand-avatar,
	.brand-fallback {
		width: 40px;
		height: 40px;
		border-radius: var(--radius-full);
		object-fit: cover;
	}

	.brand-fallback {
		background: var(--color-accent);
	}

	.nav {
		display: flex;
		align-items: center;
		gap: 48px;
	}

	.nav a {
		font-size: var(--text-base);
		font-weight: var(--weight-medium);
		line-height: var(--leading-normal);
		color: var(--color-text);
		transition: color var(--dur-base) var(--ease-ui);
	}

	.nav a:hover {
		color: var(--color-accent);
	}

	.nav a[aria-current="page"] {
		color: var(--color-muted);
	}

	.nav-admin {
		opacity: 0.6;
	}

	/* --- right: booking + mail, touching ------------------------------- */
	.actions {
		display: flex;
		align-items: center;
		gap: 0;
		flex: 0 0 auto;
	}

	.book {
		display: inline-flex;
		align-items: center;
		height: 56px;
		padding-inline: 30px;
		border-radius: 50px;
		background: var(--color-surface);
		font-size: var(--text-base);
		font-weight: var(--weight-medium);
		color: var(--color-text);
		white-space: nowrap;
		transition:
			background var(--dur-base) var(--ease-ui),
			color var(--dur-base) var(--ease-ui);
	}

	.book:hover {
		background: var(--color-accent);
		color: var(--color-on-accent);
	}

	.book-long {
		display: none;
	}

	.mail {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 56px;
		height: 56px;
		border-radius: 50px;
		background: var(--color-surface);
		color: var(--color-accent);
		flex: 0 0 auto;
		transition: background var(--dur-base) var(--ease-ui);
	}

	.mail:hover {
		background: var(--color-accent);
		color: var(--color-on-accent);
	}

	/* --- mobile disclosure --------------------------------------------- */
	.menu {
		position: relative;
		flex: 0 0 auto;
	}

	.menu-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 56px;
		height: 56px;
		border-radius: 20px;
		background: var(--color-surface);
		color: var(--color-text);
		cursor: pointer;
		list-style: none;
	}

	.menu-toggle::-webkit-details-marker {
		display: none;
	}

	/* Two bars, as on the original — not the usual three. */
	.bars {
		display: grid;
		gap: 6px;
	}

	.bars::before,
	.bars::after {
		content: "";
		display: block;
		width: 20px;
		height: 2px;
		background: currentColor;
		border-radius: 2px;
	}

	.menu-panel {
		position: absolute;
		left: 0;
		top: calc(100% + var(--space-2));
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		min-width: 13rem;
		padding: var(--space-3);
		background: var(--color-surface);
		border-radius: var(--radius-md);
		box-shadow: 0 12px 32px color-mix(in srgb, var(--color-text) 12%, transparent);
	}

	.menu-panel a {
		padding: var(--space-3) var(--space-4);
		border-radius: var(--radius-sm);
		font-size: var(--text-base);
		font-weight: var(--weight-medium);
		color: var(--color-text);
	}

	.menu-panel a:hover,
	.menu-panel a[aria-current="page"] {
		background: var(--color-bg);
	}

	/* Tablet and up: the pill replaces the disclosure. */
	@media (min-width: 810px) {
		.navpill {
			display: flex;
		}

		.menu {
			display: none;
		}
	}

	/* The long booking label only fits on the widest layout. */
	@media (min-width: 1200px) {
		.book-long {
			display: inline;
		}

		.book-short {
			display: none;
		}
	}
</style>
