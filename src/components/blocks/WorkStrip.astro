---
/**
 * WorkStrip — the band of project imagery under the hero, scrolling as one
 * continuous strip.
 *
 * Images are links, so the strip is a shortcut into the work rather than
 * decoration. With motion reduced the Ticker turns into a scrollable row.
 */
import { Image } from "emdash/ui";
import Ticker from "../primitives/Ticker.astro";

interface Props {
	projects: Array<Record<string, any>>;
}

const { projects } = Astro.props;
const withImages = projects.filter((p) => p.data.featured_image);
---

{
	withImages.length > 0 && (
		<Ticker duration={55} class="strip">
			{withImages.map((project) => (
				<a class="strip-item" href={`/project-details/${project.id}`}>
					<Image
						image={project.data.featured_image}
						alt={project.data.featured_image.alt || project.data.title}
						width={520}
						height={390}
						class="strip-img"
					/>
					<span class="sr-only">{project.data.title}</span>
				</a>
			))}
		</Ticker>
	)
}

<style>
	.strip-item {
		display: block;
		flex: 0 0 auto;
		width: clamp(15rem, 26vw, 23rem);
		border-radius: var(--radius-md);
		overflow: clip;
		background: var(--color-surface);
	}

	.strip-img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		transition: transform var(--dur-slow) var(--ease-out);
	}

	.strip-item:hover .strip-img {
		transform: scale(1.03);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}
</style>
