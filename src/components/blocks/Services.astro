---
/**
 * Services — the two-by-two card grid.
 *
 * The icon comes from a `select` field, mapped through Icon.astro. A select
 * rather than free text keeps a stored value from ever becoming an arbitrary
 * module path.
 */
import Icon from "../primitives/Icon.astro";

interface Props {
	services: Array<Record<string, any>>;
}

const { services } = Astro.props;
---

{
	services.length > 0 && (
		<ul class="grid">
			{services.map((service) => (
				<li class="service">
					<span class="service-icon">
						<Icon name={service.data.icon || "sparkle"} size={20} />
					</span>
					<h3 class="service-title">{service.data.title}</h3>
					{service.data.description && (
						<p class="service-text">{service.data.description}</p>
					)}
				</li>
			))}
		</ul>
	)
}

<style>
	.grid {
		display: grid;
		gap: var(--space-2);
		list-style: none;
	}

	.service {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-3);
		height: 100%;
		padding: var(--space-6);
		background: var(--color-surface);
		border-radius: var(--radius-md);
	}

	.service-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: var(--radius-sm);
		background: color-mix(in srgb, var(--color-accent) 12%, transparent);
		color: var(--color-accent);
		margin-bottom: var(--space-2);
	}

	.service-title {
		font-size: var(--text-lead);
		line-height: var(--leading-normal);
		font-weight: var(--weight-medium);
	}

	.service-text {
		font-size: var(--text-base);
		line-height: var(--leading-normal);
		color: var(--color-muted);
	}

	@media (min-width: 810px) {
		.grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
