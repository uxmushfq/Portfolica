---
/**
 * Process — the numbered steps.
 *
 * An ordered list, because the steps genuinely are a sequence: the numbering
 * carries meaning rather than decoration. The stored `step_number` is shown
 * as the marker so an editor controls the label.
 */
interface Props {
	steps: Array<Record<string, any>>;
}

const { steps } = Astro.props;
---

{
	steps.length > 0 && (
		<ol class="steps">
			{steps.map((step) => (
				<li class="step">
					<p class="step-number" aria-hidden="true">
						{step.data.step_number}
					</p>
					<div class="step-body">
						<h3 class="step-title">{step.data.title}</h3>
						{step.data.description && <p class="step-text">{step.data.description}</p>}
					</div>
				</li>
			))}
		</ol>
	)
}

<style>
	.steps {
		display: grid;
		gap: var(--space-2);
		list-style: none;
		counter-reset: step;
	}

	.step {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: var(--space-5);
		align-items: start;
		padding: var(--space-6);
		background: var(--color-surface);
		border-radius: var(--radius-md);
	}

	.step-number {
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
		color: var(--color-accent);
		font-variant-numeric: tabular-nums;
		padding-top: 0.35em;
		min-width: 2ch;
	}

	.step-body {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		min-width: 0;
	}

	.step-title {
		font-size: var(--text-lead);
		line-height: var(--leading-normal);
		font-weight: var(--weight-medium);
	}

	.step-text {
		font-size: var(--text-base);
		line-height: var(--leading-normal);
		color: var(--color-muted);
	}
</style>
