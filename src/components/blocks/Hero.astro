---
/**
 * Hero — rebuilt 1:1 from the source, measured at 1440.
 *
 *   section        padding 120px top / 30px bottom, 56px gap to the carousel
 *   title area     space-between, vertically centred, max-width 1200
 *   name           "Alex" [96x96 image, r24] "Morgan" — one wrapping line
 *                  box, row-gap 16px, column-gap 30px, 96px/500 at lh 1
 *   aside          476px column: rating row, intro, buttons
 *   rating         pill (zinc-50, r40, 14px/500) + caption 14px/400, gap 12
 *   intro          20px/400 at lh 26px
 *   buttons        56px tall, 16px apart
 *   carousel       280x370 cards, 20px apart, each with a name pill
 *
 * The source marks both name lines as <h1>. One <h1> is used here with the
 * parts inside it, which looks identical and leaves the page with a single
 * top-level heading.
 */
import { Image } from "emdash/ui";
import Button from "../primitives/Button.astro";
import Icon from "../primitives/Icon.astro";
import Ticker from "../primitives/Ticker.astro";

interface Props {
	options: Record<string, any> | null;
	projects: Array<Record<string, any>>;
}

const { options: o, projects } = Astro.props;
const carousel = projects.filter((p) => p.data.featured_image);
---

<section class="hero">
	<div class="container-page title-area">
		<h1 class="name">
			<span>{o?.hero_name_line_1}</span>
			{
				o?.avatar && (
					<Image
						image={o.avatar}
						alt=""
						width={96}
						height={96}
						class="name-image"
						priority
					/>
				)
			}
			<span>{o?.hero_name_line_2}</span>
		</h1>

		<div class="aside">
			<div class="proof">
				{
					(o?.rating_value || o?.rating_label) && (
						<p class="rating">
							{o.rating_value && (
						<span class="rating-pill">
							<Icon name="star" size={16} />
							{o.rating_value}
						</span>
					)}
							{o.rating_label && <span class="rating-label">{o.rating_label}</span>}
						</p>
					)
				}
				{o?.hero_tagline && <p class="intro">{o.hero_tagline}</p>}
			</div>

			<div class="buttons">
				{
					o?.cta_primary_label && (
						<Button
							href={o.cta_primary_url || "/contact"}
							label={o.cta_primary_label}
							variant="primary"
							icon="arrow"
						/>
					)
				}
				{
					o?.cta_secondary_label && (
						<Button
							href={o.cta_secondary_url || "/all-projects"}
							label={o.cta_secondary_label}
							variant="secondary"
						/>
					)
				}
			</div>
		</div>
	</div>

	{
		carousel.length > 0 && (
			<Ticker duration={55} gap={20} class="carousel">
				{carousel.map((project) => (
					<a class="card" href={`/project-details/${project.id}`}>
						<Image
							image={project.data.featured_image}
							alt={project.data.featured_image.alt || project.data.title}
							width={280}
							height={370}
							class="card-img"
						/>
						<span class="card-pill">{project.data.title}</span>
					</a>
				))}
			</Ticker>
		)
	}
</section>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		gap: 56px;
		padding-block: 120px 30px;
	}

	.title-area {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-10);
	}

	/* --- name ---------------------------------------------------------- */
	.name {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		row-gap: 16px;
		column-gap: 30px;
		font-size: var(--text-display);
		line-height: var(--leading-display);
		font-weight: var(--weight-medium);
	}

	.name-image {
		width: 96px;
		height: 96px;
		border-radius: 24px;
		object-fit: cover;
		flex: 0 0 auto;
	}

	/* --- right column -------------------------------------------------- */
	.aside {
		display: flex;
		flex-direction: column;
		gap: 24px;
		width: 100%;
		max-width: 476px;
	}

	.proof {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.rating {
		display: flex;
		align-items: center;
		gap: 12px;
		flex-wrap: wrap;
	}

	.rating-pill {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		height: 32px;
		padding-inline: 10px;
		color: var(--color-accent);
		border-radius: 40px;
		background: var(--color-surface-alt);
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
		font-variant-numeric: tabular-nums;
	}

	.rating-label {
		font-size: var(--text-sm);
		line-height: 1.3;
		color: var(--color-text);
	}

	.intro {
		font-size: var(--text-body);
		line-height: var(--leading-normal);
		color: var(--color-text);
	}

	.buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
	}

	/* --- carousel ------------------------------------------------------ */
	.card {
		position: relative;
		display: block;
		flex: 0 0 auto;
		width: 280px;
		height: 370px;
		padding: 20px;
		border-radius: 24px;
		overflow: clip;
	}

	.card-img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: scale var(--dur-slow) var(--ease-out);
	}

	.card:hover .card-img {
		scale: 1.04;
	}

	.card-pill {
		position: absolute;
		left: 20px;
		bottom: 20px;
		display: inline-flex;
		align-items: center;
		height: 48px;
		padding-inline: 24px;
		border-radius: 48px;
		background: var(--color-surface);
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
		color: var(--color-text);
	}

	@media (min-width: 1200px) {
		.title-area {
			flex-direction: row;
			justify-content: space-between;
			align-items: center;
			gap: 60px;
		}

		.aside {
			flex: 0 0 476px;
		}
	}
</style>
