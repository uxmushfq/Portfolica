---
/**
 * Button — matched to the source "Button - Primary" component.
 *
 * Measured: 56px tall, 50px radius, 10px/30px padding, 20px gap between
 * label and icon. The primary fill is a radial gradient from Primary Dark
 * to Primary Light anchored at the right edge.
 *
 * On hover the label and icon both roll: each sits in a 21px clipped box
 * holding two copies, and the pair slides up one line. The source drives
 * this with a 0.4s spring; this easing is its CSS equivalent.
 *
 * Renders an <a> when `href` is set, otherwise a <button>.
 */
import Icon from "./Icon.astro";

interface Props {
	href?: string;
	label: string;
	variant?: "primary" | "secondary" | "neutral";
	icon?: string;
	type?: "button" | "submit";
	target?: string;
	class?: string;
}

const {
	href,
	label,
	variant = "primary",
	icon,
	type = "button",
	target,
	class: className,
} = Astro.props;

const classes = ["btn", `btn-${variant}`, className].filter(Boolean).join(" ");
const external = target === "_blank";
const Tag = href ? "a" : "button";
---

<Tag
	class={classes}
	href={href}
	target={href ? target : undefined}
	rel={external ? "noopener noreferrer" : undefined}
	type={href ? undefined : type}
>
	<span class="btn-label">
		<span>{label}</span>
		<span aria-hidden="true">{label}</span>
	</span>
	{
		icon && (
			<span class="btn-icon">
				<Icon name={icon} size={24} />
				<Icon name={icon} size={24} />
			</span>
		)
	}
</Tag>

<style>
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 20px;
		height: 56px;
		padding-inline: 30px;
		border: 0;
		border-radius: 50px;
		font-size: var(--text-base);
		font-weight: var(--weight-medium);
		line-height: var(--leading-normal);
		cursor: pointer;
		white-space: nowrap;
		overflow: hidden;
		transition: background var(--dur-base) var(--ease-ui);
	}

	.btn-primary {
		background: var(--gradient-primary);
		color: var(--color-on-accent);
	}

	.btn-secondary,
	.btn-neutral {
		background: var(--color-surface);
		color: var(--color-text);
	}

	/* Label and icon each roll one line on hover. */
	.btn-label,
	.btn-icon {
		display: flex;
		flex-direction: column;
		align-items: center;
		flex: 0 0 auto;
	}

	.btn-label {
		height: 21px;
		overflow: clip;
	}

	.btn-label > span {
		display: block;
		height: 21px;
		line-height: 21px;
	}

	.btn-icon {
		height: 24px;
		width: 24px;
		overflow: clip;
	}

	.btn-label,
	.btn-icon {
		transition: translate var(--dur-base) var(--ease-out);
	}

	.btn:hover .btn-label {
		translate: 0 -21px;
	}

	.btn:hover .btn-icon {
		translate: 0 -24px;
	}
</style>
