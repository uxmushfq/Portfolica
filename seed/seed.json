    ],
    "experience": [
      { "id": "exp-1", "status": "published", "data": { "role": "Design Director", "period": "2025 - Now", "sort_order": 1 } },
      { "id": "exp-2", "status": "published", "data": { "role": "Sr. Product Designer", "period": "2024 - 2025", "sort_order": 2 } },
      { "id": "exp-3", "status": "published", "data": { "role": "Product Designer", "period": "2015 - 2024", "sort_order": 3 } },
      { "id": "exp-4", "status": "published", "data": { "role": "UI/UX Designer", "period": "2012 - 2015", "sort_order": 4 } }
    ],
    "stats": [
      { "id": "stat-1", "status": "published", "data": { "value": "100%", "label": "Client Satisfaction Rate", "sort_order": 1 } },
      { "id": "stat-2", "status": "published", "data": { "value": "50+", "label": "Projects Completed", "sort_order": 2 } },
      { "id": "stat-3", "status": "published", "data": { "value": "4X", "label": "Client Growth", "sort_order": 3 } },
      { "id": "stat-4", "status": "published", "data": { "value": "7+", "label": "Years of Experience", "sort_order": 4 } }
    ],
    "services": [
      { "id": "svc-1", "status": "published", "data": { "title": "UX-UI & Creative", "description": "Crafting clean, user-friendly sites that reflect your brand & deliver a seamless experience.", "icon": "sparkle", "sort_order": 1 } },
      { "id": "svc-2", "status": "published", "data": { "title": "Web Development", "description": "Building fast, no-code websites that are easy to manage and optimized for every device.", "icon": "code", "sort_order": 2 } },
      { "id": "svc-3", "status": "published", "data": { "title": "Brand Identity", "description": "Cohesive visual systems — from logos to colors — make your brand instantly recognizable.", "icon": "palette", "sort_order": 3 } },
      { "id": "svc-4", "status": "published", "data": { "title": "Design Consultation", "description": "Offering strategic guidance to help you plan, refine, and execute your design ideas effectively.", "icon": "compass", "sort_order": 4 } }
    ],
    "process_steps": [
      { "id": "step-1", "status": "published", "data": { "step_number": "01", "title": "Discover", "description": "Every great design starts with empathy. I dive deep into the problem to uncover insights that shape the foundation.", "sort_order": 1 } },
      { "id": "step-2", "status": "published", "data": { "step_number": "02", "title": "Design", "description": "I blend strategy, usability, and visual storytelling to design experiences that feel intuitive and look distinct.", "sort_order": 2 } },
      { "id": "step-3", "status": "published", "data": { "step_number": "03", "title": "Refine", "description": "Through feedback, testing, and iteration, I ensure the design works in the real world — not just on Figma.", "sort_order": 3 } },
      { "id": "step-4", "status": "published", "data": { "step_number": "04", "title": "Deliver", "description": "I guide projects from concept to launch, helping teams build scalable systems & maintain consistent brand experiences.", "sort_order": 4 } }
    ],
    "testimonials": [
      { "id": "tst-1", "status": "published", "data": { "quote": "Alex truly understood my vision & turned it into impactful designs, results went beyond my expectations!", "rating": "4.9", "sort_order": 1 } },
      { "id": "tst-2", "status": "published", "data": { "quote": "Alex truly understood my vision and turned it into impactful designs, the results went beyond my expectations!", "rating": "5.0", "sort_order": 2 } },
      { "id": "tst-3", "status": "published", "data": { "quote": "As a small business owner, I appreciated how stress-free Alex Morgan made the process.", "rating": "4.6", "sort_order": 3 } },
      { "id": "tst-4", "status": "published", "data": { "quote": "As a small business owner, the entire process felt effortless thanks to Alex's clear guidance & excellence.", "rating": "5.0", "sort_order": 4 } },
      { "id": "tst-5", "status": "published", "data": { "quote": "Running a small business is challenging, but Alex Morgan made this experience smooth and completely hassle-free.", "rating": "4.8", "sort_order": 5 } }
    ],
    "faqs": [
      { "id": "faq-1", "status": "published", "data": { "question": "How do we get started?", "answer": [{ "_type": "block", "_key": "faq1a", "style": "normal", "children": [{ "_type": "span", "_key": "faq1s", "text": "Send a short brief through the contact form. I reply within two working days with next steps, a rough timeline and an estimate." }] }], "sort_order": 1 } },
      { "id": "faq-2", "status": "published", "data": { "question": "Can you redesign my existing website or app?", "answer": [{ "_type": "block", "_key": "faq2a", "style": "normal", "children": [{ "_type": "span", "_key": "faq2s", "text": "Yes. Most of my work is redesign rather than greenfield. I start with an audit of what you already have so we keep what performs and fix what does not." }] }], "sort_order": 2 } },
      { "id": "faq-3", "status": "published", "data": { "question": "Do you also handle development or just design?", "answer": [{ "_type": "block", "_key": "faq3a", "style": "normal", "children": [{ "_type": "span", "_key": "faq3s", "text": "Both. I design and build, so the result matches the design exactly and nothing is lost in handover." }] }], "sort_order": 3 } },
      { "id": "faq-4", "status": "published", "data": { "question": "What tools do you use for design?", "answer": [{ "_type": "block", "_key": "faq4a", "style": "normal", "children": [{ "_type": "span", "_key": "faq4s", "text": "Figma for design and prototyping, with the build in Astro, Framer or Webflow depending on what the project needs." }] }], "sort_order": 4 } },
      { "id": "faq-5", "status": "published", "data": { "question": "Can I request additional revisions?", "answer": [{ "_type": "block", "_key": "faq5a", "style": "normal", "children": [{ "_type": "span", "_key": "faq5s", "text": "Every project includes two rounds of revisions at each stage. Further rounds are billed at my hourly rate, agreed with you first." }] }], "sort_order": 5 } }
    ],
    "skills": [
      { "id": "skill-1", "status": "published", "data": { "name": "Product Design", "group": "Technical", "sort_order": 1 } },
      { "id": "skill-2", "status": "published", "data": { "name": "Design Systems", "group": "Technical", "sort_order": 2 } },
      { "id": "skill-3", "status": "published", "data": { "name": "Prototyping", "group": "Technical", "sort_order": 3 } },
      { "id": "skill-4", "status": "published", "data": { "name": "User Research", "group": "Technical", "sort_order": 4 } },
      { "id": "skill-5", "status": "published", "data": { "name": "Brand Identity", "group": "Creative", "sort_order": 5 } },
      { "id": "skill-6", "status": "published", "data": { "name": "Art Direction", "group": "Creative", "sort_order": 6 } },
      { "id": "skill-7", "status": "published", "data": { "name": "Motion", "group": "Creative", "sort_order": 7 } },
      { "id": "skill-8", "status": "published", "data": { "name": "Webflow & Framer", "group": "Creative", "sort_order": 8 } }
    ],
    "pages": [
      {
        "id": "page-about",
        "slug": "about",
        "status": "published",
        "data": {
          "title": "A visual designer who builds digital experiences that drive real growth",
          "intro": "I help brands find clarity and express it through strong, thoughtful design.",
          "content": [
            { "_type": "block", "_key": "ab1", "style": "normal", "children": [{ "_type": "span", "_key": "ab1s", "text": "Originally from CDMX, I've been designing identities for 7+ years, working with startups, restaurants, hoteliers and creative teams across Mexico." }] },
            { "_type": "block", "_key": "ab2", "style": "normal", "children": [{ "_type": "span", "_key": "ab2s", "text": "I believe good design starts with empathy. I ask questions, listen closely, and build brands that feel as good as they look — honest, beautiful and built to last." }] }
          ]
        }
      },
      {
        "id": "page-privacy",
        "slug": "privacy-policy",
        "status": "published",
        "data": {
          "title": "Privacy Policy",
          "intro": "How this site handles your information.",
          "content": [
            { "_type": "block", "_key": "pp1", "style": "normal", "children": [{ "_type": "span", "_key": "pp1s", "text": "Replace this placeholder with your own privacy policy before you publish. This template collects no personal data by default: the contact form opens your visitor's own email client and sends nothing to this site." }] }
          ]
        }
      },
      {
        "id": "page-terms",
        "slug": "terms-conditions",
        "status": "published",
        "data": {
          "title": "Terms & Conditions",
          "intro": "The terms that apply to this site.",
          "content": [
            { "_type": "block", "_key": "tc1", "style": "normal", "children": [{ "_type": "span", "_key": "tc1s", "text": "Replace this placeholder with your own terms before you publish." }] }
          ]
        }
      }
    ],
    "projects": [
      {
        "id": "proj-connecto",
        "slug": "connecto",
        "status": "published",
        "data": {
          "title": "Connecto",
          "category": "Mobile App",
          "year": "2024",
          "summary": "Connecto is a telecom app for recharges, tracking, support, and seamless everyday mobile management.",
          "featured": true,
          "sort_order": 1,
          "challenge": [{ "_type": "block", "_key": "c1", "style": "normal", "children": [{ "_type": "span", "_key": "c1s", "text": "Customers were abandoning top-ups halfway through because the existing flow buried balance, plan and payment across four separate screens." }] }],
          "approach": [{ "_type": "block", "_key": "a1", "style": "normal", "children": [{ "_type": "span", "_key": "a1s", "text": "We collapsed the journey into a single sheet with the most-used amount preselected, and moved support into the same surface so nobody has to leave to ask a question." }] }]
        },
        "taxonomies": { "tag": ["mobile-app", "product-design"] }
      },
      {
        "id": "proj-paynest",
        "slug": "paynest",
        "status": "published",
        "data": {
          "title": "PayNest",
          "category": "Fintech",
          "year": "2024",
          "summary": "A payments dashboard that makes recurring billing legible for small teams.",
          "featured": true,
          "sort_order": 2,
          "challenge": [{ "_type": "block", "_key": "c2", "style": "normal", "children": [{ "_type": "span", "_key": "c2s", "text": "Finance leads could see totals but never why a number moved, so every month ended in a manual reconciliation." }] }],
          "approach": [{ "_type": "block", "_key": "a2", "style": "normal", "children": [{ "_type": "span", "_key": "a2s", "text": "Each figure became traceable to the events behind it, with changes since last month surfaced first rather than hidden in a report." }] }]
        },
        "taxonomies": { "tag": ["product-design", "web-design"] }
      },
      {
        "id": "proj-shopora",
        "slug": "shopora",
        "status": "published",
        "data": {
          "title": "Shopora",
          "category": "E-commerce",
          "year": "2024",
          "summary": "A storefront system built for independent retailers who manage their own catalogue.",
          "featured": true,
          "sort_order": 3,
          "challenge": [{ "_type": "block", "_key": "c3", "style": "normal", "children": [{ "_type": "span", "_key": "c3s", "text": "Owners were editing products on their phones between customers, but the admin assumed a desktop and a quiet moment." }] }],
          "approach": [{ "_type": "block", "_key": "a3", "style": "normal", "children": [{ "_type": "span", "_key": "a3s", "text": "We rebuilt the catalogue editor mobile-first, so a price change takes three taps and survives a dropped connection." }] }]
        },
        "taxonomies": { "tag": ["web-design", "product-design"] }
      },
      {
        "id": "proj-edunova",
        "slug": "edunova",
        "status": "published",
