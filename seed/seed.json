{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "meta": {
    "name": "Portfolica",
    "description": "A personal portfolio template for designers, studios and freelancers.",
    "author": "Muzency"
  },
  "settings": {
    "title": "Alex Morgan",
    "tagline": "Visual designer who builds digital experiences that drive real growth",
    "postsPerPage": 12,
    "dateFormat": "MMM D, YYYY",
    "timezone": "UTC"
  },
  "collections": [
    {
      "slug": "projects",
      "label": "Projects",
      "labelSingular": "Project",
      "description": "Case studies shown in the work grid and on their own detail pages.",
      "supports": ["drafts", "revisions", "preview", "search", "seo"],
      "urlPattern": "/project-details/{slug}",
      "titleField": "title",
      "sortOrder": 1,
      "fields": [
        { "slug": "title", "label": "Title", "type": "string", "required": true, "searchable": true },
        { "slug": "featured_image", "label": "Featured image", "type": "image", "required": true },
        { "slug": "category", "label": "Category", "type": "string", "ui": { "helpText": "Shown on the project card chip, e.g. \"Mobile App\"." } },
        { "slug": "year", "label": "Year", "type": "string", "ui": { "helpText": "Shown next to the category, e.g. \"2024\"." } },
        { "slug": "summary", "label": "Summary", "type": "text", "searchable": true, "ui": { "rows": 3 } },
        { "slug": "challenge", "label": "Challenge", "type": "portableText", "searchable": true },
        { "slug": "approach", "label": "Approach", "type": "portableText", "searchable": true },
        {
          "slug": "gallery",
          "label": "Gallery",
          "type": "repeater",
          "validation": {
            "maxItems": 24,
            "subFields": [
              { "slug": "image", "label": "Image", "type": "image", "required": true },
              { "slug": "caption", "label": "Caption", "type": "text" }
            ]
          }
        },
        { "slug": "url", "label": "Live URL", "type": "url" },
        { "slug": "featured", "label": "Show on homepage", "type": "boolean", "defaultValue": true },
        { "slug": "sort_order", "label": "Order", "type": "integer", "defaultValue": 0, "indexed": true }
      ]
    },
    {
      "slug": "pages",
      "label": "Pages",
      "labelSingular": "Page",
      "description": "Standalone pages such as About and the legal pages.",
      "supports": ["drafts", "revisions", "preview", "search", "seo"],
      "titleField": "title",
      "sortOrder": 2,
      "fields": [
        { "slug": "title", "label": "Title", "type": "string", "required": true, "searchable": true },
        { "slug": "intro", "label": "Intro", "type": "text", "ui": { "rows": 3 } },
        { "slug": "content", "label": "Content", "type": "portableText", "searchable": true }
      ]
    },
    {
      "slug": "services",
      "label": "Services",
      "labelSingular": "Service",
      "routable": false,
      "group": "Sections",
      "sortOrder": 3,
      "titleField": "title",
      "fields": [
        { "slug": "title", "label": "Title", "type": "string", "required": true },
        { "slug": "description", "label": "Description", "type": "text", "ui": { "rows": 3 } },
        {
          "slug": "icon",
          "label": "Icon",
          "type": "select",
          "defaultValue": "sparkle",
          "validation": { "options": ["sparkle", "code", "palette", "compass"] },
          "ui": { "helpText": "Maps to an icon component. See AGENTS.md to add more." }
        },
        { "slug": "sort_order", "label": "Order", "type": "integer", "defaultValue": 0, "indexed": true }
      ]
    },
    {
      "slug": "experience",
      "label": "Career history",
      "labelSingular": "Role",
      "routable": false,
      "group": "Sections",
      "sortOrder": 4,
      "titleField": "role",
      "fields": [
        { "slug": "role", "label": "Role", "type": "string", "required": true },
        { "slug": "company", "label": "Company", "type": "string" },
        { "slug": "period", "label": "Period", "type": "string", "required": true, "ui": { "helpText": "Free text, e.g. \"2025 - Now\"." } },
        { "slug": "sort_order", "label": "Order", "type": "integer", "defaultValue": 0, "indexed": true }
      ]
    },
    {
      "slug": "process_steps",
      "label": "Process steps",
      "labelSingular": "Step",
      "routable": false,
      "group": "Sections",
      "sortOrder": 5,
      "titleField": "title",
      "fields": [
        { "slug": "step_number", "label": "Number", "type": "string", "ui": { "helpText": "Displayed as-is, e.g. \"01\"." } },
        { "slug": "title", "label": "Title", "type": "string", "required": true },
        { "slug": "description", "label": "Description", "type": "text", "ui": { "rows": 3 } },
        { "slug": "sort_order", "label": "Order", "type": "integer", "defaultValue": 0, "indexed": true }
      ]
    },
    {
      "slug": "stats",
      "label": "Stats",
      "labelSingular": "Stat",
      "routable": false,
      "group": "Sections",
      "sortOrder": 6,
      "titleField": "label",
      "fields": [
        { "slug": "value", "label": "Value", "type": "string", "required": true, "ui": { "helpText": "e.g. \"100%\", \"50+\", \"4X\"." } },
        { "slug": "label", "label": "Label", "type": "string", "required": true },
        { "slug": "sort_order", "label": "Order", "type": "integer", "defaultValue": 0, "indexed": true }
      ]
    },
    {
      "slug": "testimonials",
      "label": "Testimonials",
      "labelSingular": "Testimonial",
      "routable": false,
      "group": "Sections",
      "sortOrder": 7,
      "titleField": "quote",
      "fields": [
        { "slug": "quote", "label": "Quote", "type": "text", "required": true, "ui": { "rows": 3 } },
        { "slug": "rating", "label": "Rating", "type": "string", "ui": { "helpText": "e.g. \"4.9\". Leave empty to hide." } },
        { "slug": "avatar", "label": "Client photo", "type": "image" },
        { "slug": "author_name", "label": "Name", "type": "string", "ui": { "helpText": "Optional. Renders only when filled — the original design shows none." } },
        { "slug": "author_role", "label": "Role / company", "type": "string", "ui": { "helpText": "Optional. Renders only when filled." } },
        { "slug": "sort_order", "label": "Order", "type": "integer", "defaultValue": 0, "indexed": true }
      ]
    },
    {
      "slug": "faqs",
      "label": "FAQs",
      "labelSingular": "FAQ",
      "routable": false,
      "group": "Sections",
      "sortOrder": 8,
      "titleField": "question",
      "fields": [
        { "slug": "question", "label": "Question", "type": "string", "required": true, "searchable": true },
        { "slug": "answer", "label": "Answer", "type": "portableText", "searchable": true },
        { "slug": "sort_order", "label": "Order", "type": "integer", "defaultValue": 0, "indexed": true }
      ]
    },
    {
      "slug": "skills",
      "label": "Skills",
      "labelSingular": "Skill",
      "routable": false,
      "group": "Sections",
      "sortOrder": 9,
      "titleField": "name",
      "fields": [
        { "slug": "name", "label": "Name", "type": "string", "required": true },
        { "slug": "group", "label": "Group", "type": "string", "ui": { "helpText": "e.g. \"Technical\" or \"Creative\"." } },
        { "slug": "sort_order", "label": "Order", "type": "integer", "defaultValue": 0, "indexed": true }
      ]
    },
    {
      "slug": "site_options",
      "label": "Site options",
      "labelSingular": "Site options",
      "description": "Global values that do not belong to any one page.",
      "routable": false,
      "hidden": false,
      "sortOrder": 10,
      "titleField": "hero_name_line_1",
      "fields": [
        { "slug": "hero_name_line_1", "label": "Hero line 1", "type": "string", "required": true },
        { "slug": "hero_name_line_2", "label": "Hero line 2", "type": "string" },
        { "slug": "hero_tagline", "label": "Hero tagline", "type": "text", "ui": { "rows": 3 } },
        { "slug": "avatar", "label": "Avatar", "type": "image" },
        { "slug": "availability_badge", "label": "Availability badge", "type": "string", "ui": { "helpText": "Small pill next to the hero, e.g. \"Available for work\"." } },
        { "slug": "cta_primary_label", "label": "Primary button label", "type": "string" },
        { "slug": "cta_primary_url", "label": "Primary button URL", "type": "string" },
        { "slug": "cta_secondary_label", "label": "Secondary button label", "type": "string" },
        { "slug": "cta_secondary_url", "label": "Secondary button URL", "type": "string" },
        { "slug": "booking_url", "label": "Booking URL", "type": "url", "ui": { "helpText": "The \"Book a 30 min call\" link in the header." } },
        { "slug": "contact_email", "label": "Contact email", "type": "string", "required": true, "validation": { "format": "email" }, "ui": { "helpText": "Receives the contact form. Change this before you publish." } },
        {
          "slug": "socials",
          "label": "Social links",
          "type": "repeater",
          "validation": {
            "maxItems": 10,
            "subFields": [
              {
                "slug": "platform",
                "label": "Platform",
                "type": "select",
                "required": true,
                "validation": { "options": ["behance", "dribbble", "x", "figma", "instagram", "linkedin", "github", "youtube"] }
              },
              { "slug": "url", "label": "URL", "type": "url", "required": true }
            ]
          }
        },
        { "slug": "copyright_line", "label": "Copyright line", "type": "string" },
        { "slug": "notfound_heading", "label": "404 heading", "type": "string" },
        { "slug": "notfound_body", "label": "404 body", "type": "text", "ui": { "rows": 2 } }
      ]
    }
  ],
  "taxonomies": [
    {
      "name": "tag",
      "label": "Tags",
      "labelSingular": "Tag",
      "hierarchical": false,
      "collections": ["projects"],
      "terms": [
        { "slug": "mobile-app", "label": "Mobile App" },
        { "slug": "web-design", "label": "Web Design" },
        { "slug": "branding", "label": "Branding" },
        { "slug": "product-design", "label": "Product Design" }
      ]
    }
  ],
  "menus": [
    {
      "name": "primary",
      "label": "Primary navigation",
      "items": [
        { "type": "custom", "label": "About", "url": "/about" },
        { "type": "custom", "label": "All Projects", "url": "/all-projects" },
        { "type": "custom", "label": "Contact", "url": "/contact" },
        { "type": "custom", "label": "404", "url": "/404" }
      ]
    },
    {
      "name": "legal",
      "label": "Legal links",
      "items": [
        { "type": "custom", "label": "Privacy Policy", "url": "/legal/privacy-policy" },
        { "type": "custom", "label": "Terms & Conditions", "url": "/legal/terms-conditions" }
      ]
    }
  ],
  "content": {
    "site_options": [
      {
        "id": "site-options",
        "status": "published",
        "data": {
          "hero_name_line_1": "Alex",
          "hero_name_line_2": "Morgan",
          "hero_tagline": "I build digital experiences that drive real growth for your business. Let's partner to create work that gets results.",
          "availability_badge": "Available for work",
          "cta_primary_label": "Book a Project",
          "cta_primary_url": "/contact",
          "cta_secondary_label": "See Projects",
          "cta_secondary_url": "/all-projects",
          "booking_url": "https://cal.com",
          "contact_email": "hello@example.com",
          "socials": [
            { "platform": "behance", "url": "https://behance.net" },
            { "platform": "dribbble", "url": "https://dribbble.com" },
            { "platform": "x", "url": "https://x.com" },
